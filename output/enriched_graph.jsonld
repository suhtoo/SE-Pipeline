  {
    "@id": "https://w3id.org/brcomp#ConstructionJoint",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Separation lines within components. They occur, for example, in concrete construction as set-down joints between successive concreting sections. Concreting in several stages is often unavoidable due to the construction process. The aim is to create the best possible bond between the adjacent concreting sections. Since the reinforcement runs through the construction joints, a traditional shuttering of the concreting section with wood would be costly. Today, expanded metal is mostly used for this purpose, which can be easily cut and bent to size and guarantees a certain degree of interlocking of the concreting sections. If, for example, a straight line of joints is desired for aesthetic reasons, formwork panels can be used in combination with a reverse bending connection for the reinforcing irons, which allow subsequent interlocking by bending up the reinforcing bars as the concreting process continues. In engineering structures such as bridges, screw connections are used to connect the reinforcement steel over construction joints due to the higher loads."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "de",
        "@value": "Arbeitsfuge"
      },
      {
        "@language": "en",
        "@value": "Construction joint"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/brot#Joint"
      },
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      },
      {
        "@id": "https://w3id.org/brcomp#ConstructionJoint"
      }
    ],
    "http://www.w3.org/2002/07/owl#equivalentClass": [
      {
        "@id": "https://w3id.org/brcomp#ConstructionJoint"
      }
    ],
    "http://www.w3.org/2002/07/owl#sameAs": [
      {
        "@id": "https://w3id.org/brcomp#ConstructionJoint"
      }
    ]
  },
