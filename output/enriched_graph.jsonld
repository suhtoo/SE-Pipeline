    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "de",
        "@value": "Diese Relation stellt dar, dass ein Component sich über einem anderen befindet. Die Componente sind nicht gezwungen einen physicalischen bzw. logischen Kontakt zu haben. Die Relation zeigt bloß das räumliche Verhalten."
      },
      {
        "@language": "en",
        "@value": "This relationship points that in a modell an Component located above an another Component. The Components are not obliged to have a physical or logical connection. The relationship shows only space atittude."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "de",
        "@value": "befindet sich über"
      },
      {
        "@language": "en",
        "@value": "located above"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://w3id.org/brot#locatedAbove"
      }
    ],
